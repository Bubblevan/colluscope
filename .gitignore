# M1-100 local raw traces include private agent message text and request payloads.
/runs/m1_100/
# M1-P0 local raw traces include private agent message text and request payloads.
/runs/m1_p0_local/
# M2 run artifacts include private synthetic messages and raw monitor requests/responses.
/runs/m2/
# M2-V2 local raw requests/responses and Privileged Audit projections are private.
/runs/m2-v2/
# M2-V3 offline response tables remain local research evidence; do not publish rows by default.
/runs/m2-v3/
# M3 stores actual synthetic private messages and complete prompts locally.
/runs/m3/
# Sprint monitor runs contain complete prompts, private synthetic messages,
# responses, API errors, and scoring references; keep them local and ACL-restricted.
/runs/sprint-monitor/
# M4 Agent runs contain private prompts, generated messages, and action traces.
/runs/m4/
